# Copy to .env for plain `next dev` / the Docker deploy, AND to .dev.vars
# for `wrangler dev` / `npm run cf:preview` (Cloudflare Workers local
# emulation) — same values, two files, because Next's own env loading reads
# the former and Wrangler's local dev reads the latter. See README.md for
# what each of these does and where to get it.

# --- App ---
# Public origin this service is reachable at. Used to build the Paystack
# callback URL and every download link this service emails or displays.
APP_URL=http://localhost:4100

# --- Database ---
# Only used by local Prisma CLI commands (`prisma generate`, `prisma
# migrate dev` against this throwaway file, to author new migration SQL) —
# the deployed app reaches Cloudflare D1 through a binding instead, never
# through this value. See prisma.config.ts and this README's "Database
# (Cloudflare D1)" section.
DATABASE_URL=file:./dev.db

# --- Paystack ---
# Secret key only — this service uses the redirect/hosted-checkout flow, so
# no public key or client-side Paystack.js is needed.
# Dashboard -> Settings -> API Keys & Webhooks.
PAYSTACK_SECRET_KEY=sk_test_xxx
# Register https://<APP_URL>/api/webhooks/paystack in the same settings page.

# --- Cloudinary ---
# Same account already used by okhubtech.com. Videos live here as
# "authenticated" delivery-type assets so signed download URLs can expire.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (delivery-method: EMAIL, and nothing else) ---
# HTTP API (resend.com, has a free tier) — not SMTP. Cloudflare Workers has
# no raw TCP socket support the way an SMTP transport needs it.
RESEND_API_KEY=
EMAIL_FROM=store@okhub.tech

# --- Admin ---
# Single operator account — no user table. Generate ADMIN_SESSION_SECRET with
# `openssl rand -hex 32`. Required to log into /admin at all — see lib/env.ts:
# each feature area (admin, Cloudinary, Resend, Paystack, delivery) validates
# independently, so you can fill in just this block, log in, and add
# Cloudinary/Resend/Paystack later when you're ready to actually sell something.
ADMIN_EMAIL=admin@okhub.tech
ADMIN_PASSWORD=change-me-to-something-long
ADMIN_SESSION_SECRET=

# --- Delivery ---
# How long a download link stays valid, and how many times it can be used.
DOWNLOAD_TOKEN_TTL_HOURS=72
DOWNLOAD_MAX_USES=5
