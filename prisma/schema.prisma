// Video store: catalog + checkout + gated delivery.
//
// Runs on Cloudflare D1 (a SQLite-compatible database Cloudflare hosts for
// you — no server to run yourself), reached through Prisma's driver adapter
// rather than a DATABASE_URL connection string: Workers has no persistent
// filesystem to open a local .db file from, so the runtime connection comes
// from the D1 binding in wrangler.jsonc instead — see lib/prisma.ts.
//
// Pinned to Prisma 6.19.3, not the current 7.x — Prisma 7's new WASM query
// compiler does runtime WebAssembly compilation, which Cloudflare Workers
// blocks outright ("Wasm code generation disallowed by embedder"); this is a
// confirmed upstream regression with no fix as of this writing
// (github.com/prisma/prisma/issues/28657), and 6.19.x is the last version
// documented to actually work on Workers. Re-check that issue before ever
// bumping past 7.10.0 here.
//
// `url` below is only read by local CLI commands (`prisma generate`,
// `prisma migrate dev` against a throwaway local SQLite file to author new
// migrations) — the deployed app never reads DATABASE_URL, connecting to D1
// through the adapter in lib/prisma.ts instead. See this service's README,
// "Database (Cloudflare D1)", for the full local-authoring-vs-D1-deploy
// split, and migrations/ (wrangler's own D1 migration files, derived from
// prisma/migrations/ — not the same directory).
// The newer `prisma-client` generator (not `prisma-client-js`), with
// `runtime = "cloudflare"`, is what Prisma's own Cloudflare D1 guide
// documents to avoid the client trying to load a native query-engine
// binary at runtime — the actual thing that broke on Workers even with the
// D1 adapter configured (see the 6.19.3 pin note above; this is a second,
// separate fix from the WASM-query-compiler version pin). Outputs plain
// TypeScript source (not a packaged node_modules dependency), so it lives
// in-repo under generated/, gitignored and regenerated by `prisma generate`
// (which @prisma/client's own postinstall hook also runs automatically).
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma-client"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Prisma's SQLite connector has no enum support (this schema tried it first —
// see the "Error validating: ... does not support enums" failure it produces
// on `prisma generate`), so OrderStatus ("PENDING" | "PAID" | "FAILED" |
// "ABANDONED") and DeliveryMethod ("DOWNLOAD" | "EMAIL") are plain strings,
// validated at the application boundary instead: lib/checkout.ts's
// checkoutInputSchema for what comes in, and lib/fulfillment.ts as the only
// place status is ever written.

/// A sellable video. The catalog itself — title, description, thumbnail.
/// Pricing and the actual deliverable live one level down, on Variant, because
/// one video can be sold at more than one tier (resolution, raw vs edited,
/// with/without source files) at different prices.
model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String
  /// Cloudinary public id (image) or a plain https URL, shown on the storefront.
  thumbnailUrl String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  variants    Variant[]

  @@index([active])
}

/// A purchasable edition of a Product: a price, and exactly one way to resolve
/// the actual deliverable — either a Cloudinary asset (cloudinaryPublicId set)
/// or an externally hosted file such as a Google Drive / Dropbox share link
/// (externalAssetUrl set). Application code enforces "exactly one of the two";
/// see lib/variant.ts#assertValidAsset and tests/variant.test.ts.
model Variant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// Smallest currency unit (kobo for NGN), matching how Paystack itself bills.
  priceKobo   Int
  currency    String   @default("NGN")

  cloudinaryPublicId   String?
  cloudinaryResourceType String @default("video")
  externalAssetUrl     String?

  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@index([productId])
}

/// One purchase of one variant. No multi-item cart: the storefront sells one
/// video edition per checkout, which is the whole of what was asked for.
/// Title/name/price are snapshotted at purchase time so a later catalog edit
/// (price change, rename) never rewrites what a past order says the buyer paid for.
model Order {
  id              String         @id @default(cuid())
  reference       String         @unique
  /// "PENDING" | "PAID" | "FAILED" | "ABANDONED" — see the note above Product.
  status          String         @default("PENDING")

  variantId       String
  variant         Variant        @relation(fields: [variantId], references: [id])
  productTitle    String
  variantName     String
  amountKobo      Int
  currency        String         @default("NGN")

  customerEmail   String
  customerName    String?
  /// "DOWNLOAD" | "EMAIL" — see the note above Product.
  deliveryMethod  String

  paystackAuthorizationUrl String?
  paystackAccessCode      String?
  paidAt          DateTime?

  grants          DeliveryGrant[]
  webhookEvents   WebhookEvent[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([customerEmail])
}

/// A token-gated right to download the deliverable behind a paid order.
/// The buyer never sees the raw asset URL — only /download/[token], which
/// checks expiry and use count here before redirecting to the real asset.
model DeliveryGrant {
  id        String       @id @default(cuid())
  token     String       @unique
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  maxUses   Int          @default(5)
  useCount  Int          @default(0)
  expiresAt DateTime
  createdAt DateTime     @default(now())
  accessLogs AccessLog[]

  @@index([orderId])
}

model AccessLog {
  id        String        @id @default(cuid())
  grantId   String
  grant     DeliveryGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  createdAt DateTime      @default(now())

  @@index([grantId])
}

/// Every Paystack webhook delivery, kept for idempotency and for debugging a
/// disputed payment. transactionId is Paystack's own `data.id`, which is
/// stable across retried webhook deliveries for the same event.
model WebhookEvent {
  id            String    @id @default(cuid())
  eventType     String
  transactionId Int
  reference     String
  rawPayload    String
  orderId       String?
  order         Order?    @relation(fields: [orderId], references: [id])
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@unique([eventType, transactionId])
}
